    "test": "vitest run",
    "clean": "node ../../scripts/clean-paths.mjs dist"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.5.0",
    "lucide-react": "^0.513.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.0.16"
  }
